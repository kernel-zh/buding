# ===========================================
# These are secrets for GitHub Actions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key
# End of GitHub Actions section.
# ===========================================

# These are used by the Next.js server on Vercel and local preview.
# Read-only values used by the Next.js server on Vercel and local preview.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only value used by scripts/publish-supabase.ts and GitHub Actions.
# Never put this in NEXT_PUBLIC_* or commit a real value.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Server-only status authentication. Generate distinct high-entropy values and
# keep them out of all NEXT_PUBLIC_* variables.
BUDING_API_KEY_PEPPER=replace-with-a-random-secret
BUDING_API_SESSION_SECRET=replace-with-a-different-random-secret
# Root key for creating/revoking ordinary API keys. Do not use it as a daily
# operator key, and never expose it in NEXT_PUBLIC_* variables.
BUDING_ADMIN_KEY=replace-with-a-third-random-secret
# Hidden, direct URL for the API-key management page; for example:
BUDING_ADMIN_PATH=/manage-keys-choose-a-long-random-suffix
# Optional: a browser session lasts 30 days by default and refreshes when 7
# days remain. Refresh must be strictly smaller than the lifetime.
BUDING_API_SESSION_DAYS=30
BUDING_API_SESSION_REFRESH_DAYS=7
